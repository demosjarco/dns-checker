{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dns-probe",
	// "main": "./dist/_worker.js",
	"main": "src/entry.cloudflare-workers.ts",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal", "request_signal_passthrough"],
	"workers_dev": false,
	"preview_urls": false,
	"route": { "pattern": "dns.demosjarco.dev", "custom_domain": true, "previews_enabled": true },
	"minify": true,
	"keep_names": false,
	"upload_source_maps": true,
	"observability": { "logs": { "enabled": true, "invocation_logs": true, "persist": true }, "issues": { "enabled": true }, "traces": { "enabled": true, "persist": true } },
	"limits": { "cpu_ms": 30000, "subrequests": 10000000 },
	"dependencies_instrumentation": { "enabled": false },
	"vars": {
		"NODE_ENV": "production",
		// 1 hour * 60 minutes * 60 seconds
		"SQL_TTL": "3600"
	},
	"secrets": { "required": ["CF_API_TOKEN"] },
	"assets": {
		"directory": "./dist",
		"run_worker_first": false
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "LOCATION_TESTER",
				"class_name": "LocationTester"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "PROBE_DB",
			"database_name": "dns-probe",
			"database_id": "db1f9a6b-1650-4571-a79b-008e4ab26b13",
			"migrations_dir": "db",
			"migrations_pattern": "db/*/migration.sql",
			"remote": true
		}
	],
	"exports": {
		"LocationTester": {
			"type": "durable-object",
			"storage": "sqlite",
			"state": "created"
		}
	},
	"workflows": [
		{
			"name": "dns-update-iatas",
			"binding": "UPDATE_IATAS",
			"class_name": "UpdateIatas",
			"limits": { "steps": 25000 },
			"schedules": ["0 * * * *"],
			"default_retention": { "success_retention": "3 days", "error_retention": "3 days" }
		}
	]
}
